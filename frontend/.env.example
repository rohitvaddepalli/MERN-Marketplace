# Clerk authentication (frontend SDK)
# Get these from: Clerk Dashboard → API Keys
REACT_APP_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# API Configuration
# Local dev: leave unset (defaults to http://localhost:5000)
# Cloudflare Pages: set to your backend origin, e.g. https://api.yourdomain.com
# REACT_APP_API_URL=https://api.yourdomain.com

# Optional: web-vitals production reporting endpoint
# REACT_APP_ANALYTICS_URL=https://your-analytics-endpoint
