# ──────────────────────────────────────────────────────────────────────────────
# frontend/.env.production – Cloudflare Pages Production Environment
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to frontend/.env.production and fill in your real values.
# With the Cloudflare Pages git integration you can instead set these in
# Pages → Settings → Environment variables (production + preview).
#
# ⚠️  Do NOT commit the filled-in .env.production file to git.
# ──────────────────────────────────────────────────────────────────────────────

# ── Clerk SDK ────────────────────────────────────────────────────────────────
# Clerk Dashboard → API Keys → Publishable Key (pk_live_… in production)
REACT_APP_CLERK_PUBLISHABLE_KEY=pk_live_your_publishable_key_here

# ── API URL ──────────────────────────────────────────────────────────────────
# Absolute origin of the Express backend (Neon-backed API). The backend's
# CORS allowlist must include this Pages origin (FRONTEND_URL / ALLOWED_ORIGINS).
REACT_APP_API_URL=https://api.yourdomain.com
