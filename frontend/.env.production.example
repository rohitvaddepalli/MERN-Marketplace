# ──────────────────────────────────────────────────────────────────────────────
# frontend/.env.production  –  Firebase Hosting Production Environment
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to frontend/.env.production and fill in your real values.
# Get these values from: Firebase Console → Project Settings → Your web app → SDK setup
#
# ⚠️  Do NOT commit the filled-in .env.production file to git.
# ──────────────────────────────────────────────────────────────────────────────

# ── Firebase SDK Config ───────────────────────────────────────────────────────
REACT_APP_FIREBASE_API_KEY=your-api-key-here
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=123456789
REACT_APP_FIREBASE_APP_ID=1:123456789:web:abcdef123456
# Optional – only needed if you enable Google Analytics in Firebase
REACT_APP_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ── API URL ───────────────────────────────────────────────────────────────────
# Keep this as /api  – Firebase Hosting rewrites /api/** to the Cloud Function.
# Do NOT change this to an absolute URL unless you are NOT using Firebase Hosting.
REACT_APP_API_URL=/api
