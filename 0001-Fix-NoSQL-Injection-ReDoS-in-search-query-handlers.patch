 backend/controllers/productController.js | 27 +-----------------------
 backend/controllers/storeController.js   |  6 ++++--
 backend/utils/securityUtils.js           | 26 +++++++++++++++++++++++
 4 files changed, 47 insertions(+), 39 deletions(-)
 create mode 100644 backend/utils/securityUtils.js

