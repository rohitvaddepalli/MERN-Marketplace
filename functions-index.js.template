/**
 * Firebase Cloud Functions Entry Point
 * This wraps your existing Express backend to run as a Cloud Function
 */

const functions = require('firebase-functions');
const express = require('express');
const mongoose = require('mongoose');
const cors = require('cors');
const path = require('path');
const session = require('express-session');
const passport = require('passport');

// Create Express app
const app = express();

// Middleware
app.use(cors({ origin: true, credentials: true }));
app.use(express.json({ limit: '50mb' }));
app.use(express.urlencoded({ extended: true, limit: '50mb' }));

// Session middleware
app.use(session({
    secret: functions.config().session?.secret || 'fallback-secret',
    resave: false,
    saveUninitialized: false,
    cookie: {
        secure: true, // HTTPS only
        httpOnly: true,
        maxAge: 24 * 60 * 60 * 1000 // 24 hours
    }
}));

// Passport middleware (if using OAuth)
app.use(passport.initialize());
app.use(passport.session());

// MongoDB connection management
let isConnected = false;

const connectDB = async () => {
    if (isConnected) {
        console.log('Using existing MongoDB connection');
        return;
    }

    try {
        const mongoUri = functions.config().mongodb?.uri;
        
        if (!mongoUri) {
            throw new Error('MongoDB URI not configured. Run: firebase functions:config:set mongodb.uri="your-connection-string"');
        }

        await mongoose.connect(mongoUri, {
            useNewUrlParser: true,
            useUnifiedTopology: true,
            serverSelectionTimeoutMS: 5000,
            socketTimeoutMS: 45000,
        });

        isConnected = true;
        console.log('✅ MongoDB Connected via Cloud Functions');
    } catch (error) {
        console.error('❌ MongoDB Connection Error:', error.message);
        throw error;
    }
};

// Middleware to ensure DB connection before each request
app.use(async (req, res, next) => {
    try {
        await connectDB();
        next();
    } catch (error) {
        res.status(500).json({
            success: false,
            message: 'Database connection error',
            error: error.message
        });
    }
});

// Import routes from your existing backend
// Note: Adjust paths based on your project structure
const authRoutes = require('../backend/routes/auth');
const storeRoutes = require('../backend/routes/stores');
const productRoutes = require('../backend/routes/products');
const orderRoutes = require('../backend/routes/orders');
const adminRoutes = require('../backend/routes/admin');
const analyticsRoutes = require('../backend/routes/analytics');
const userRoutes = require('../backend/routes/users');

// Mount routes (all prefixed with /api in firebase.json rewrite)
app.use('/auth', authRoutes);
app.use('/stores', storeRoutes);
app.use('/products', productRoutes);
app.use('/orders', orderRoutes);
app.use('/admin', adminRoutes);
app.use('/analytics', analyticsRoutes);
app.use('/users', userRoutes);

// Public settings endpoint
app.get('/settings', async (req, res) => {
    try {
        const Settings = (await import('../backend/models/Settings.js')).default;
        const settings = await Settings.getSettings();
        res.status(200).json({
            success: true,
            settings: {
                taxRate: settings.taxRate,
                shippingFee: settings.shippingFee
            }
        });
    } catch (error) {
        res.status(500).json({
            success: false,
            message: 'Error fetching settings',
            error: error.message
        });
    }
});

// Health check endpoint
app.get('/health', (req, res) => {
    res.status(200).json({
        success: true,
        message: 'API is running on Firebase Cloud Functions! 🔥',
        timestamp: new Date().toISOString(),
        environment: 'production',
        mongodb: isConnected ? 'connected' : 'disconnected'
    });
});

// Root endpoint
app.get('/', (req, res) => {
    res.json({
        success: true,
        message: 'MERN Marketplace API',
        version: '1.0.0',
        endpoints: {
            health: '/api/health',
            auth: '/api/auth/*',
            stores: '/api/stores/*',
            products: '/api/products/*',
            orders: '/api/orders/*',
            users: '/api/users/*',
            admin: '/api/admin/*',
            analytics: '/api/analytics/*'
        }
    });
});

// Error handler middleware
app.use((err, req, res, next) => {
    console.error('Error:', err);
    res.status(err.statusCode || 500).json({
        success: false,
        message: err.message || 'Internal Server Error',
        ...(process.env.NODE_ENV === 'development' && { stack: err.stack })
    });
});

// Export the Express app as a Cloud Function named 'api'
// This will be accessible at: https://your-project.web.app/api/*
exports.api = functions
    .runWith({
        timeoutSeconds: 60,
        memory: '512MB'
    })
    .https
    .onRequest(app);

// Optional: Scheduled function to keep the function warm (prevents cold starts)
exports.keepWarm = functions.pubsub
    .schedule('every 5 minutes')
    .onRun(async (context) => {
        console.log('Keeping function warm...');
        try {
            await connectDB();
            console.log('Function is warm and DB is connected');
        } catch (error) {
            console.error('Keep warm error:', error);
        }
        return null;
    });
