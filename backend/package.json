{
    "name": "marketplace-backend",
    "version": "1.0.0",
    "description": "Backend for Marketplace Application",
    "main": "firebase-entry.js",
    "engines": {
        "node": ">=18"
    },
    "type": "module",
    "scripts": {
        "dev": "nodemon server.js",
        "start": "node server.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:integration": "vitest run --config vitest.integration.config.js",
        "migrate": "node scripts/migrate.js",
        "migrate:create": "node scripts/migrate.js create",
        "analyze:indexes": "node scripts/analyzeIndexes.js",
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@sentry/node": "^10.53.1",
        "@sentry/profiling-node": "^10.53.1",
        "bcryptjs": "^2.4.3",
        "cloudinary": "^2.10.0",
        "compression": "^1.8.1",
        "connect-mongo": "^6.0.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-mongo-sanitize": "^2.2.0",
        "express-rate-limit": "^8.2.1",
        "express-session": "^1.18.2",
        "express-validator": "^7.3.1",
        "firebase-admin": "^13.0.0",
        "firebase-functions": "^6.0.0",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.0.3",
        "multer": "^2.0.0",
        "multer-storage-cloudinary": "^2.2.1",
        "nodemailer": "^8.0.7",
        "opossum": "^9.0.0",
        "passport": "^0.7.0",
        "passport-google-oauth20": "^2.0.0",
        "qrcode": "^1.5.4",
        "socket.io": "^4.8.3",
        "speakeasy": "^2.0.0",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1",
        "validator": "^13.11.0",
        "winston": "^3.19.0",
        "xss-clean": "^0.1.4"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "eslint": "^9.39.4",
        "globals": "^15.15.0",
        "mongodb-memory-server": "^9.1.6",
        "nodemon": "^3.0.2",
        "prettier": "^3.8.3",
        "supertest": "^6.3.0",
        "vitest": "^3.2.4"
    },
    "overrides": {
        "ws": "8.20.1"
    }
}