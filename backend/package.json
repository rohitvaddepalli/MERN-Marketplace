{
    "name": "marketplace-backend",
    "version": "1.0.0",
    "description": "Backend for Marketplace Application",
    "main": "server.js",
    "engines": {
        "node": ">=18"
    },
    "type": "module",
    "scripts": {
        "dev": "nodemon server.js",
        "start": "node server.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:integration": "vitest run --config vitest.integration.config.js",
        "migrate": "node scripts/migrate-pg.js",
        "migrate:seed": "node scripts/migrate-pg.js --seed",
        "seed": "node scripts/seed-pg.js",
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1149.0",
        "@aws-sdk/s3-request-presigner": "^3.1149.0",
        "@clerk/express": "^2.1.78",
        "@neon/env": "^1.5.1",
        "@sentry/node": "^10.53.1",
        "@sentry/profiling-node": "^10.53.1",
        "compression": "^1.8.1",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-rate-limit": "^8.2.1",
        "helmet": "^8.1.0",
        "multer": "^2.0.0",
        "opossum": "^9.0.0",
        "pg": "^8.23.1",
        "resend": "^6.32.1",
        "socket.io": "^4.8.3",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1",
        "uuid": "^14.0.2",
        "validator": "^13.11.0",
        "winston": "^3.19.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@neon/config": "^1.8.4",
        "eslint": "^9.39.4",
        "globals": "^15.15.0",
        "nodemon": "^1.14.10",
        "prettier": "^3.8.3",
        "supertest": "^6.3.0",
        "vitest": "^5.0.2"
    },
    "overrides": {
        "ws": "^8.21.0",
        "braces": "^3.0.3",
        "uuid": "$uuid"
    }
}
