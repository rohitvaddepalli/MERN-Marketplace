# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database (Neon Postgres) ─────────────────────────────────────────────────
# Pooled connection string (runtime queries). Neon console → Connection Details.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Direct (unpooled) URL — used by migrations for schema changes.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# PG_SSL=false only for a local Postgres without TLS
# PG_SSL=false

# ── Authentication (Clerk) ───────────────────────────────────────────────────
# Clerk Dashboard → API Keys → Secret Key (server-side only — never expose)
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# ── Frontend (Cloudflare Pages) ──────────────────────────────────────────────
# Production Pages origin allowed by CORS
FRONTEND_URL=https://your-project.pages.dev
# Extra comma-separated origins (staging, custom domains)
# ALLOWED_ORIGINS=https://www.yourdomain.com,https://staging.yourdomain.com
# Set to 'true' to allow any *.pages.dev preview deployment origin
ALLOW_PAGES_PREVIEW=true

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_api_key_here
FROM_EMAIL=Marketplace <onboarding@resend.dev>

# ── Storage (Cloudflare R2, S3-compatible) ───────────────────────────────────
# R2 → Manage R2 API Tokens (object read & write). Account ID is top-right on
# the Cloudflare dashboard. Endpoint form:
#   https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=marketplace
# Public base URL for served objects (custom domain or https://pub-xxx.r2.dev)
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# ── Security ─────────────────────────────────────────────────────────────────
# Used only for legacy/test token paths; Clerk owns sessions now.
# JWT_SECRET=generate-a-long-random-string

# ── Optional / deployment ────────────────────────────────────────────────────
# SENTRY_DSN=
# PRODUCTION_API_URL=
# REQUEST_TIMEOUT_MS=30000
# REACT_APP_ANALYTICS_URL=
