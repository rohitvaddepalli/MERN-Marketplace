# Backend Environment Variables Template
# Copy this file to .env and fill in your actual values

# ===========================================
# CRITICAL SECURITY CONFIGURATION
# ===========================================

# MongoDB Connection String
# Get this from MongoDB Atlas or your MongoDB provider
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/marketplace

# JWT Secret - CRITICAL: Generate a strong random secret
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Minimum 256 bits (64 hex characters) recommended
JWT_SECRET=your_super_secret_jwt_key_here_minimum_64_characters

# JWT Token Expiration
JWT_EXPIRE=7d

# Session Secret - CRITICAL: Generate a strong random secret
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_session_secret_here_minimum_32_characters

# ===========================================
# SERVER CONFIGURATION
# ===========================================

# Server Port
PORT=5000

# Node Environment (development | production)
# IMPORTANT: Set to 'production' in deployment
NODE_ENV=development

# Frontend URL - Used for CORS and OAuth redirects
# MUST match your actual frontend deployment URL
FRONTEND_URL=http://localhost:3000

# ===========================================
# EMAIL CONFIGURATION (Password Reset)
# ===========================================

# SMTP Email Configuration
# Note: Variable names must match your sendEmail.js implementation
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_email_app_password

# ===========================================
# OAUTH PROVIDERS (Optional)
# ===========================================

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ===========================================
# SECURITY NOTES
# ===========================================
#
# 1. NEVER commit your .env file to version control
# 2. Use different secrets for development and production
# 3. Rotate secrets periodically in production
# 4. Use environment variables in your hosting platform
#    (Render, Heroku, Vercel, Railway, etc.)
# 5. In production, ensure NODE_ENV=production for:
#    - Secure cookies (HTTPS only)
#    - Stricter session settings
#    - Optimized error messages
#
# Generate secure secrets with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
