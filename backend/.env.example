# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/marketplace
# For MongoDB Atlas, use:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/marketplace

# Security - JWT & Session
JWT_SECRET=your_jwt_secret_here_minimum_32_characters_recommended
SESSION_SECRET=your_session_secret_here_minimum_32_characters

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Cloudinary Configuration (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google OAuth (optional - for social login)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Email / SMTP Configuration (required for password reset emails)
# ⚠️  PRODUCTION: Switch to a transactional provider — Gmail triggers spam filters
#     and has low daily send limits. Recommended alternatives:
#       SendGrid:  SMTP_HOST=smtp.sendgrid.net  SMTP_PORT=587
#       Postmark:  SMTP_HOST=smtp.postmarkapp.com  SMTP_PORT=587
#       AWS SES:   SMTP_HOST=email-smtp.us-east-1.amazonaws.com  SMTP_PORT=587
# Development only — use Gmail with an App Password (2FA required):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
FROM_NAME=Marketplace
FROM_EMAIL=noreply@marketplace.com

# Deployment (optional - for production)
# RENDER_EXTERNAL_URL=your_render_app_url
# PRODUCTION_API_URL=https://your-custom-domain.com   # Used for Swagger production server URL
# REQUEST_TIMEOUT_MS=30000                            # Request timeout in ms (default: 30000)
# REACT_APP_ANALYTICS_URL=https://your-analytics.com/collect  # For Web Vitals reporting (frontend)
