# Backend Environment Variables Template
# Copy this file and fill in your actual values when deploying

# MongoDB Connection
MONGODB_URI=your_mongodb_atlas_connection_string

# JWT Secret (generate a random string)
JWT_SECRET=your_super_secret_jwt_key_here

# Server Port
PORT=5000

# Node Environment
NODE_ENV=production

# Frontend URL (Your Firebase Hosting URL)
FRONTEND_URL=https://your-project-id.web.app

# Session Secret (generate a random string)
SESSION_SECRET=your_session_secret_here

# Email Configuration (for password reset)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password

# Google OAuth (Optional - if using Google login)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://your-backend-url.onrender.com/api/auth/google/callback

# GitHub OAuth (Optional - if using GitHub login)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=https://your-backend-url.onrender.com/api/auth/github/callback
