rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read access to products and stores
    match /products/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /stores/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // User data - only the owner can read/write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Orders - Users can read/write their own orders
    match /orders/{orderId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (resource.data.user == request.auth.uid || request.auth.token.role == 'admin');
    }
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
